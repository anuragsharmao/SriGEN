# Gemini API key (primary backend by default — get one free, no credit card,
# at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
# Used for Fact Graph extraction, Sensitivity Firewall classification, and
# Source Understanding when the Gemini backend is active.
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite

# Groq API Key (fallback backend by default — used automatically if Gemini
# fails or its free-tier quota is exhausted; see LLM_FALLBACK_BACKEND below)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Used ONLY for Fact Graph extraction and Sensitivity Firewall classification
# when the Groq backend is active (primary or fallback).
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Pluggable LLM backend selection — "groq" and "gemini" are both implemented.
# LLM_BACKEND is tried first on every call; LLM_FALLBACK_BACKEND is tried
# automatically if the primary raises (missing/invalid key, rate limit,
# 5xx, connection failure). Set LLM_FALLBACK_BACKEND to blank or the same
# value as LLM_BACKEND to disable fallback.
LLM_BACKEND=gemini
LLM_FALLBACK_BACKEND=groq

# Database Configuration
DATABASE_URL=sqlite:///./srigen.db

# Security & Provenance Configuration
OPERATOR_ID=operator_sec_01
CHAIN_DIFFICULTY_BITS=0
MAX_UPLOAD_SIZE_MB=25

# CORS: comma-separated explicit allowlist. Never include "*" — it is stripped
# automatically since allow_credentials is always True once auth is in play.
CORS_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000

# Auth bootstrap: creates ONE 'approver' account on first startup if (and only
# if) no operator exists yet. Leave both unset once real accounts exist, and
# never use these defaults in a shared/production environment.
OPERATOR_BOOTSTRAP_USERNAME=
OPERATOR_BOOTSTRAP_PASSWORD=

# API Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
